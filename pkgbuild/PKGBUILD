pkgname=gitrepo
pkgdesc="A comprehensive tool for building and managing packages in BigCommunity repositories and AUR, with Git workflow automation and CI/CD integration"
# Uncomment and edit the following lines as needed
depends=(
    'curl'
    'git'
    'libadwaita'
    'python'
    'python-cairo'
    'python-gobject'
    'python-requests'
    'python-rich'
    'xdg-utils'
)
checkdepends=('python-pytest' 'ruff')
optdepends=(
    'docker: build ISO images with Docker'
    'libnotify: show desktop notifications'
    'podman: build ISO images with Podman'
)
#conflicts=('')
#provides=('')
#replaces=('')
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('any')
license=('MIT')
url="https://github.com/big-comm/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')

# Automatically detect and use the correct install file
if [ -e "${pkgname}.install" ]; then
    install=${pkgname}.install
elif [ -e "pkgbuild.install" ]; then
    install=pkgbuild.install
fi

prepare() {
    cd "${srcdir}/${pkgname}"
    # Add any preparation steps here, if needed
    # For example: patch -p1 < "${srcdir}/patch-file.patch"
}

build() {
    cd "${srcdir}/${pkgname}"
    # Add build steps here, if needed
    # For example: make
}

check() {
    cd "${srcdir}/${pkgname}"
    PYTHONDONTWRITEBYTECODE=1 pytest -q -p no:cacheprovider
    RUFF_CACHE_DIR="${srcdir}/ruff-cache" ruff check usr/share/build-package usr/share/build-iso tests
    PYTHONPYCACHEPREFIX="${srcdir}/pycache" python -m compileall -q usr/share/build-package usr/share/build-iso
}

package() {
    cd "${srcdir}/${pkgname}"

    # Determine the correct source directory
    if [ -d "${pkgname}" ]; then
        srcdir="${srcdir}/${pkgname}/${pkgname}"
    else
        srcdir="${srcdir}/${pkgname}"
    fi

    # Install files
    local dirs=("usr" "etc" "opt")
    for dir in "${dirs[@]}"; do
        if [ -d "${srcdir}/${dir}" ]; then
            cp -a "${srcdir}/${dir}" "${pkgdir}/"
        fi
    done

    # Install license file if present
    if [ -f "LICENSE" ]; then
        install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi

    # Install documentation if present
    if [ -f "README.md" ]; then
        install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    fi
}
