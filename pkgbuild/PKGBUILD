# Maintainer: Tales A. Mendonça <talesam@gmail.com>
# shellcheck shell=bash

pkgname=gitrepo
pkgdesc="Git workflow, package automation, and ISO build tools for BigCommunity"
depends=('bash' 'git' 'gtk4' 'libadwaita' 'libsecret' 'python' 'python-gobject' 'python-requests' 'python-rich' 'xdg-utils')
makedepends=('gettext' 'python-pytest')
optdepends=(
    'docker: local ISO builds with Docker'
    'libnotify: desktop notification for invalid context-menu selections'
    'nautilus-python: Nautilus context menu integration'
    'podman: local ISO builds with Podman'
)
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('any')
license=('MIT')
url="https://github.com/big-comm/${pkgname}"
_commit=caa265612c8697c842023358b22d3ebfef60a9b8
source=("${pkgname}::git+${url}.git#commit=${_commit}")
b2sums=('SKIP')

check() {
    cd "${pkgname}" || return
    PYTHONPATH="$PWD/usr/share" python -m pytest -q
}

package() {
    cd "${pkgname}" || return
    cp -a usr "${pkgdir}/"

    find "${pkgdir}" -type f \( -name '*.pyc' -o -name '*.pyo' \) -delete
    find "${pkgdir}" -depth -type d -name '__pycache__' -empty -delete
    find "${pkgdir}" -depth -type d -empty -delete

    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
