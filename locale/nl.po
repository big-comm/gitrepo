#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:58
msgid "The token identifies your account so the app can start GitHub workflows that Git alone cannot. It authorizes one organization or user, and saving it does not verify its permissions. Package workflows need: repo, workflow, write:packages, delete:packages, read:org."
msgstr "Het token identificeert uw account, zodat de app GitHub-workflows kan starten die Git alleen niet kan uitvoeren. Het machtigt één organisatie of gebruiker, en het opslaan ervan controleert niet of de rechten geldig zijn. Package-workflows hebben nodig: repo, workflow, write:packages, delete:packages, read:org."
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:67
msgid "Create a classic access token on GitHub"
msgstr "Een klassiek toegangstoken aanmaken op GitHub"
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:79
msgid "Save or replace an access token"
msgstr "Een toegangstoken opslaan of vervangen"
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:83
msgid "Use the GitHub organization or username that owns the repositories where workflows will run."
msgstr "Gebruik de GitHub-organisatie of gebruikersnaam die eigenaar is van de repositories waar de workflows worden uitgevoerd."
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:87
msgid "GitHub organization or username"
msgstr "GitHub-organisatie of gebruikersnaam"
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:92
msgid "Personal access token"
msgstr "Persoonlijke toegangstoken"
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:97
msgid "Store in the system keyring"
msgstr "Opslaan in systeemsleutelbos"
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:98
msgid "The token value will be cleared from this form after it is stored."
msgstr "De tokenwaarde wordt uit dit formulier gewist nadat deze is opgeslagen."
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:99
msgid "Save access token"
msgstr "Toegangstoken opslaan"
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:108
msgid "Checking the system keyring…"
msgstr "Systeemsleutelbos wordt gecontroleerd…"
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:123
msgid "No access tokens saved"
msgstr "Geen opgeslagen toegangstokens"
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:124
msgid "Use the form below when you want to run a GitHub workflow."
msgstr "Gebruik onderstaand formulier wanneer u een GitHub-workflow wilt uitvoeren."
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:132
msgid "Stored securely in the system keyring"
msgstr "Veilig opgeslagen in het systeemsleutelbos"
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:138
#, python-brace-format
msgid "Delete access token for {0}"
msgstr "Toegangstoken verwijderen voor {0}"
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:150
msgid "Enter both the GitHub organization and the access token."
msgstr "Voer zowel de GitHub-organisatie als de toegangstoken in."
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:178
msgid "Access token saved in the system keyring"
msgstr "Toegangstoken opgeslagen in het systeemsleutelbos"
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:190
msgid "Access token removed"
msgstr "Toegangstoken verwijderd"
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:194
msgid "The token could not be removed. Unlock the system keyring and try again."
msgstr "Het token kon niet worden verwijderd. Ontgrendel het systeemsleutelbos en probeer het opnieuw."
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:218
msgid "Choose how local Git operations behave"
msgstr "Kies hoe lokale Git-operaties zich gedragen"
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:220
msgid "These settings affect work in the current repository. They do not connect to GitHub and do not require an access token."
msgstr "Deze instellingen hebben invloed op het werk in de huidige repository. Ze maken geen verbinding met GitHub en vereisen geen toegangstoken."
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:232
msgid "When downloaded and local changes conflict"
msgstr "Bij conflicten tussen gedownloade en lokale wijzigingen"
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:235
msgid "Protection against data loss"
msgstr "Bescherming tegen gegevensverlies"
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:237
msgid "Safety confirmations are part of the app and cannot be disabled: it always asks before a force push, a hard reset, branch cleanup, tag deletion, or workflow deletion."
msgstr "Veiligheidsbevestigingen zijn onderdeel van de app en kunnen niet worden uitgeschakeld: de app vraagt altijd om bevestiging vóór een force push, hard reset, opruimen van branches, verwijderen van tags of verwijderen van workflows."
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:243
msgid "Choose whether the app asks you what to keep or stops so you can resolve the conflict manually."
msgstr "Kies of de app vraagt wat u wilt behouden of stopt zodat u het conflict handmatig kunt oplossen."
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:246
msgid "Conflict resolution method"
msgstr "Methode voor conflictoplossing"
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:248
msgid "Ask each time"
msgstr "Elke keer vragen"
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:249
msgid "Keep local changes"
msgstr "Lokale wijzigingen behouden"
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:250
msgid "Keep downloaded changes"
msgstr "Gedownloade wijzigingen behouden"
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:251
msgid "Resolve manually"
msgstr "Handmatig oplossen"
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:259
msgid "Package version and defaults"
msgstr "Pakketversie en standaardwaarden"
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:261
msgid "Update the package version automatically"
msgstr "De pakketversie automatisch bijwerken"
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:263
msgid "When publishing a typed commit, calculate the next version from the selected change type."
msgstr "Bereken bij het publiceren van een typed commit de volgende versie op basis van het geselecteerde wijzigingstype."
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:269
msgid "Reset all Build Package settings"
msgstr "Alle Build Package-instellingen resetten"
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:270
msgid "Disable optional GitHub workflows and restore the recommended local Git behavior."
msgstr "Schakel optionele GitHub-workflows uit en herstel het aanbevolen lokale Git-gedrag."
#: usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:271 usr/share/gitrepo/build_package/gui/widgets/settings_widgets.py:314
msgid "Reset settings"
msgstr "Instellingen resetten"
