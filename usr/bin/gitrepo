#!/bin/sh

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
share_dir=$(CDPATH='' cd -- "$script_dir/../share" && pwd)

if [ "$#" -gt 1 ]; then
	printf '%s\n' "GitRepo accepts at most one directory." >&2
	exit 2
fi

if [ "$#" -eq 1 ]; then
	if [ ! -d "$1" ]; then
		printf 'Not a directory: %s\n' "$1" >&2
		exit 2
	fi
	if ! git_root=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null); then
		message="The selected folder is not inside a Git repository: $1"
		printf '%s\n' "$message" >&2
		if command -v notify-send >/dev/null 2>&1; then
			notify-send --app-name=GitRepo --icon=dialog-warning "Not a Git Repository" "$message"
		fi
		exit 1
	fi
	cd "$git_root" || exit 1
fi

export PYTHONPATH="$share_dir${PYTHONPATH:+:$PYTHONPATH}"

exec python3 -c 'from gitrepo.build_package.gui.main_gui import main; raise SystemExit(main())'
